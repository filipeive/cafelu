{
  "appId": "mz.co.restpos.app",
  "appName": "RestPOS",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "url": "http://146.235.224.99/RestPOS/",
    "cleartext": true,
    "allowNavigation": [
      "*"
    ]
  },
  "plugins": {
